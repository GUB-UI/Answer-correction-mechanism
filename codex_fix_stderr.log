import json

from harness_v2.core.contracts import ProviderExchange
from harness_v2.core.orchestrator import Orchestrator
from harness_v2.core.pipeline import Pipeline
from harness_v2.improvement.proposals import build_proposal
from harness_v2.providers.gemma_ai_studio import QuotaExceeded
from harness_v2.storage.artifacts import ArtifactStore
from harness_v2.storage.sqlite_store import RunStore


def _case(input_id: str, raw: str) -> dict:
    return {
        "input_id": input_id,
        "request_id": input_id,
        "problem_text": "solve",
        "answer_text": "x+1",
        "rubric_version": "rubric-v0",
        "prompt_version": "prompt-v0",
        "reference_score": 99,
        "prior_ai_score": 1,
        "rubric": [{"item_id": "R1", "max_points": 4, "description": "work", "acceptable_expression": "1+x"}],
        "new_completion": raw,
        "image_path": "/tmp/student.png",
    }


def _valid() -> str:
    return json.dumps(
        {
            "items": [
                {
                    "item_id": "R1",
                    "max_points": 4,
                    "score": 4,
                    "evidence_spans": [{"text": "x+1"}],
                    "math_reason": "matches",
                    "uncertainty": 0.2,
                    "review_reason": "",
                }
            ],
            "total_score": 4,
        }
    )


class _Scripted:
    def __init__(self, raw: str) -> None:
        self.raw = raw
        self.calls = 0

    def generate(self, prompt: str, *, request_id: str, settings=None):
        del settings
        self.calls += 1
        if self.calls >= 2:
            raise QuotaExceeded(
                ProviderExchange(
                    request_id=request_id,
                    model_requested="gemma-4-31b-it",
                    model_returned="",
                    settings={},
                    input_tokens=2,
                    output_tokens=0,
                    latency_ms=5,
                    raw_response="quota body",
                    status="quota",
                    error="429",
                    attempt_count=1,
                )
            )
        assert "reference_score" not in prompt
        assert "99" not in prompt
        return ProviderExchange(
            request_id=request_id,
            model_requested="gemma-4-31b-it",
            model_returned="gemma-4-31b-it",
            settings={"temperature": 0},
            input_tokens=8,
            output_tokens=4,
            latency_ms=12,
            raw_response=self.raw,
            status="ok",
        )


def test_quota_persists_partial_results_and_stops(tmp_path, monkeypatch) -> None:
    monkeypatch.setenv("GEMINI_API_KEY", "unique-test-key-value")
    store = RunStore(tmp_path / "runs.sqlite", ArtifactStore(tmp_path / "artifacts"))
    provider = _Scripted(_valid())
    result = Orchestrator(Pipeline(store, provider)).run(
        [_case("a", _valid()), _case("b", _valid()), _case("c", _valid())],
        experiment_id="exp-1",
        commit="a383b29",
    )
    assert result.stopped_reason == "quota"
    assert [record.request_id for record in result.records] == ["a", "b"]
    assert provider.calls == 2
    saved = {row["request_id"]: row for row in store.list_runs()}
    assert saved["a"]["outputs"]["grading"]["status"] == "validated"
    assert saved["a"]["failure_reason"] == ""
    assert saved["a"]["input_tokens"] == 8
    assert saved["b"]["failure_reason"] == "quota"
    blob = (tmp_path / "runs.sqlite").read_bytes()
    assert b"unique-test-key-value" not in blob
    assert b"student.png" not in blob
    assert not list((tmp_path / "artifacts").rglob("*.png"))
    prompt = (tmp_path / "artifacts" / "prompts" / "a.txt").read_text(encoding="utf-8")
    assert "reference_score" not in prompt


def test_parse_failure_links_a_proposal_and_does_not_apply_it(tmp_path) -> None:
    store = RunStore(tmp_path / "runs.sqlite", ArtifactStore(tmp_path / "artifacts"))
    provider = _Scripted("not json at all")
    record = Pipeline(store, provider).run(_case("a", "not json"), experiment_id="exp", commit="abc")
    assert record.outputs["grading"]["status"] == "failed"
    assert record.proposal_link
    proposal = json.loads(
        (tmp_path / "artifacts" / "proposals" / f"{record.proposal_link}.json").read_text(encoding="utf-8")
    )
    assert proposal["decision"] == "pending"
    assert proposal["changed_components"] == ["prompt"]
    assert proposal["baseline_commit"] == "abc"
    assert proposal["candidate_commit"] == ""
    assert "status" not in proposal
    built = build_proposal([])
    assert built is None
    saved = store.list_runs()[0]
    assert saved["outputs"]["settings"]["temperature"] == 0
    assert saved["outputs"]["attempt_count"] == 1
    assert saved["outputs"]["ocr_sha256"]
    private = tmp_path / "artifacts" / saved["outputs"]["ocr_artifact"]
    assert private.read_bytes() == b"x+1"


def test_codex_disagreement_routes_to_review_required(tmp_path) -> None:
    store = RunStore(tmp_path / "runs.sqlite", ArtifactStore(tmp_path / "artifacts"))
    seen: list[dict] = []

    class _Reviewer:
        def review_independent(self, payload, *, request_id):
            del request_id
            seen.append(payload)
            return type("Outcome", (), {"to_dict": lambda self: {"text": json.dumps({"total_score": 0})}})()

    case = _case("a", _valid())
    case["problem_text"] = 'solve {"reference_score":8,"predicted_score":1}'
    case["predicted_score"] = 4
    record = Pipeline(store, _Scripted(_valid()), codex_reviewer=_Reviewer()).run(
        case,
        experiment_id="exp",
        commit="abc",
    )
    blob = json.dumps(seen)
    assert "reference_score" not in blob
    assert "predicted_score" not in blob
    assert record.outputs["grading"]["status"] == "review_required"
    assert record.outputs["independent_review"]["text"]
    assert "independent_review" in record.failure_reason
from __future__ import annotations

import json
import sys
import time

import pytest

from harness_v2.providers.codex_app_server import (
    DEFAULT_MODEL,
    SANDBOX_SCHEMA,
    CodexAppServer,
    CodexRPCError,
    ModelUnavailable,
    sandbox_modes,
    start_app_server,
    validate_thread_start_params,
)
from harness_v2.storage.artifacts import ArtifactStore
from harness_v2.storage.sqlite_store import RunStore


class Script:
    def __init__(self, replies: list[dict]) -> None:
        self.replies = list(replies)
        self.sent: list[dict] = []

    def send(self, message: dict) -> None:
        self.sent.append(message)

    def read(self, timeout: float | None = None) -> dict:
        del timeout
        return self.replies.pop(0)


def _ready(model: str = DEFAULT_MODEL) -> list[dict]:
    return [
        {"id": 1, "result": {"userAgent": "codex"}},
        {"id": 2, "result": {"data": [{"model": model}], "nextCursor": None}},
        {"id": 3, "result": {"thread": {"id": "thr_1"}}},
    ]


def test_turn_completed_saves_text(tmp_path) -> None:
    script = Script(
        _ready()
        + [
            {"id": 4, "result": {"thread": {"id": "thr_fresh"}}},
            {"id": 5, "result": {"turn": {"id": "turn_1", "status": "inProgress", "items": []}}},
            {
                "method": "turn/completed",
                "params": {
                    "turn": {
                        "id": "turn_1",
                        "status": "completed",
                        "items": [{"type": "agentMessage", "text": "{\"ok\":true}"}],
                    }
                },
            },
        ]
    )
    client = CodexAppServer(script)
    client.require_model()
    thread_id = client.start_thread()
    result = client.start_turn(
        thread_id,
        "reference_score: 99\nprior_ai_score: 3\ngrade the work",
        request_id="req",
        independent=True,
    )
    assert result.status == "completed"
    assert result.text == "{\"ok\":true}"
    assert result.thread_id == "thr_fresh"
    sent_text = script.sent[-1]["params"]["input"][0]["text"]
    assert "99" not in sent_text
    assert "reference_score" not in sent_text
    assert "prior_ai_score" not in sent_text
    assert "[redacted-score]" in sent_text
    methods = [message["method"] for message in script.sent]
    assert methods[:6] == [
        "initialize",
        "initialized",
        "model/list",
        "thread/start",
        "thread/start",
        "turn/start",
    ]
    store = RunStore(tmp_path / "runs.sqlite", ArtifactStore(tmp_path / "artifacts"))
    name = client.save_result(store, result)
    assert "req" in store.artifacts.read_text(name)


def test_failed_and_interrupt_notifications() -> None:
    script = Script(
        _ready()
        + [
            {
                "id": 4,
                "result": {
                    "turn": {
                        "id": "turn_9",
                        "status": "failed",
                        "items": [],
                        "error": {"message": "model failed"},
                    }
                },
            },
            {"id": 5, "result": {}},
        ]
    )
    client = CodexAppServer(script)
    client.require_model()
    thread_id = client.start_thread()
    failed = client.start_turn(thread_id, "grade", request_id="req", independent=False)
    assert failed.status == "failed"
    assert failed.error == "model failed"
    client.interrupt(thread_id, failed.turn_id)
    assert script.sent[-1]["method"] == "turn/interrupt"
    assert script.sent[-1]["params"] == {"threadId": thread_id, "turnId": "turn_9"}


def test_sandbox_is_read_only_per_schema() -> None:
    schema = json.loads(SANDBOX_SCHEMA.read_text(encoding="utf-8"))
    assert schema["enum"] == ["read-only", "workspace-write", "danger-full-access"]
    assert sandbox_modes() == schema["enum"]
    assert "readOnly" not in schema["enum"]
    script = Script(_ready())
    client = CodexAppServer(script)
    client.require_model()
    client.start_thread()
    params = script.sent[-1]["params"]
    assert params["sandbox"] == "read-only"
    assert params["sandbox"] in schema["enum"]
    with pytest.raises(CodexRPCError):
        validate_thread_start_params({**params, "sandbox": "readOnly"})


def test_notification_arriving_before_response_is_not_lost() -> None:
    script = Script(
        _ready()
        + [
            {
                "method": "turn/completed",
                "params": {
                    "turn": {
                        "id": "turn_1",
                        "status": "completed",
                        "items": [{"type": "agentMessage", "text": "early"}],
                    }
                },
            },
            {"id": 4, "result": {"turn": {"id": "turn_1", "status": "inProgress", "items": []}}},
        ]
    )
    client = CodexAppServer(script)
    client.require_model()
    result = client.start_turn(client.start_thread(), "grade", request_id="req", independent=False)
    assert result.status == "completed"
    assert result.text == "early"
    assert script.replies == []


def test_server_request_is_not_treated_as_our_response() -> None:
    script = Script(
        _ready()
        + [
            {"id": 4, "method": "item/commandExecution/requestApproval", "params": {"command": "rm"}},
            {
                "id": 4,
                "result": {
                    "turn": {
                        "id": "turn_1",
                        "status": "completed",
                        "items": [{"type": "agentMessage", "text": "ok"}],
                    }
                },
            },
        ]
    )
    client = CodexAppServer(script)
    client.require_model()
    result = client.start_turn(client.start_thread(), "grade", request_id="req", independent=False)
    assert result.text == "ok"
    replies = [message for message in script.sent if message.get("id") == 4 and "method" not in message]
    assert replies == [{"id": 4, "result": {}}]


def test_stdio_times_out_drains_stderr_and_kills_the_child() -> None:
    transport = start_app_server(
        [
            sys.executable,
            "-c",
            "import sys,time; sys.stderr.write('err-marker\\n'); sys.stderr.flush(); time.sleep(60)",
        ]
    )
    try:
        with pytest.raises(CodexRPCError, match="timed out"):
            transport.read(timeout=0.3)
        deadline = time.time() + 2
        while time.time() < deadline and not any("err-marker" in line for line in transport.stderr_lines):
            time.sleep(0.05)
        assert any("err-marker" in line for line in transport.stderr_lines)
    finally:
        transport.close()
    assert transport._process.poll() is not None


def test_stdio_context_manager_closes() -> None:
    with start_app_server([sys.executable, "-c", "import time; time.sleep(60)"]) as transport:
        assert transport._process.poll() is None
    assert transport._process.poll() is not None


def test_model_must_be_listed() -> None:
    script = Script(
        [
            {"id": 1, "result": {"userAgent": "codex"}},
            {"id": 2, "result": {"data": [{"model": "other"}], "nextCursor": None}},
        ]
    )
    client = CodexAppServer(script)
    with pytest.raises(ModelUnavailable):
        client.require_model()
from __future__ import annotations

import json

from harness_v2.evaluation.independent import (
    grading_allowlist,
    prepare_independent_input,
    proposal_review_allowlist,
)


def test_allowlist_drops_scores_including_nested_json_strings() -> None:
    payload = {
        "problem_text": 'solve {"reference_score":8,"predicted_score":1}',
        "answer_text": "x+1",
        "predicted_score": 4,
        "reference_score": 99,
        "prior_ai_score": 1,
        "note": "reference_score: 99",
        "rubric": [
            {
                "item_id": "R1",
                "max_points": 4,
                "description": "work",
                "score": 4,
                "acceptable_expression": "1+x",
            }
        ],
    }
    view = prepare_independent_input(payload)
    assert set(view) == {"problem_text", "answer_text", "rubric"}
    blob = json.dumps(view)
    assert "reference_score" not in blob
    assert "predicted_score" not in blob
    assert "prior_ai_score" not in blob
    assert view["rubric"][0]["max_points"] == 4
    assert "score" not in view["rubric"][0]
    assert grading_allowlist(payload) == view


def test_proposal_review_keeps_the_failure_without_scores() -> None:
    payload = {
        "failure_case": {
            "case_id": "c1",
            "problem_id": "p1",
            "input_version": "v1",
            "model_version": "m",
            "harness_version": "0.1.0",
            "rubric_version": "v0",
            "predicted_score": 3,
            "reference_score": 9,
            "rubric_results": [
                {"item_id": "R1", "score": 3, "max_points": 4, "note": '{"predicted_score":3}'}
            ],
            "evidence": [],
            "errors": ["score_range"],
            "uncertainty": 0.2,
            "execution_log": [],
        },
        "diff": "reference_score: 9\n+ prompt line",
    }
    view = proposal_review_allowlist(payload)
    blob = json.dumps(view)
    assert "predicted_score" not in blob
    assert "reference_score" not in blob
    assert view["rubric_results"][0]["max_points"] == 4
    assert "score" not in view["rubric_results"][0]
    assert "prompt line" in view["diff"]
    assert view["case_id"] == "c1"
from __future__ import annotations

import json
from types import SimpleNamespace

import pytest

from harness_v2.providers.gemma_ai_studio import (
    MODEL_ID,
    GemmaAIStudio,
    MissingAPIKey,
    ProviderSetupError,
    QuotaExceeded,
)


class _Models:
    def __init__(self, behavior) -> None:
        self.behavior = behavior
        self.calls: list[dict] = []

    def generate_content(self, **kwargs):
        self.calls.append(kwargs)
        return self.behavior(kwargs)


def _client(behavior):
    models = _Models(behavior)
    return SimpleNamespace(models=models), models


def test_missing_key_does_not_build_a_client(monkeypatch) -> None:
    monkeypatch.delenv("GEMINI_API_KEY", raising=False)
    monkeypatch.setenv("GOOGLE_API_KEY", "other-project-key")
    with pytest.raises(MissingAPIKey):
        GemmaAIStudio().generate("grade this", request_id="r1")


def test_non_json_response_is_kept(monkeypatch) -> None:
    monkeypatch.setenv("GEMINI_API_KEY", "should-not-be-read")

    def behavior(_kwargs):
        return SimpleNamespace(
            text="this is not json",
            model_version="gemma-4-31b-it-2026",
            response_id="resp-9",
            usage_metadata=SimpleNamespace(prompt_token_count=11, candidates_token_count=7),
        )

    client, models = _client(behavior)
    exchange = GemmaAIStudio(client=client).generate(
        "prompt",
        request_id="r2",
        settings={
            "temperature": 0,
            "max_output_tokens": 128,
            "model": "gemini-2.5-pro",
            "api_key": "secret-value",
        },
    )
    assert exchange.raw_response == "this is not json"
    assert exchange.model_requested == MODEL_ID
    assert exchange.model_returned == "gemma-4-31b-it-2026"
    assert exchange.provider_response_id == "resp-9"
    assert exchange.input_tokens == 11
    assert exchange.output_tokens == 7
    assert models.calls[0]["model"] == MODEL_ID
    assert "api_key" not in models.calls[0]["config"]
    assert "model" not in models.calls[0]["config"]
    assert models.calls[0]["config"]["max_output_tokens"] == 128
    assert exchange.settings["max_output_tokens"] == 128
    assert exchange.provider_response_id == "resp-9"
    assert exchange.attempt_count == 1
    assert "secret-value" not in json.dumps(exchange.to_dict())


def test_quota_stops_without_retry() -> None:
    slept: list[float] = []

    class QuotaError(Exception):
        code = 429

    def behavior(_kwargs):
        raise QuotaError("RESOURCE_EXHAUSTED quota")

    client, models = _client(behavior)
    with pytest.raises(QuotaExceeded) as caught:
        GemmaAIStudio(client=client, sleep=slept.append).generate("prompt", request_id="r3")
    assert slept == []
    assert len(models.calls) == 1
    assert caught.value.exchange.status == "quota"
    assert caught.value.exchange.attempt_count == 1
    assert "RESOURCE_EXHAUSTED" in caught.value.exchange.raw_response


def test_transient_errors_retry_then_stop() -> None:
    slept: list[float] = []

    class ServerError(Exception):
        status_code = 503

    def behavior(_kwargs):
        raise ServerError("unavailable")

    client, models = _client(behavior)
    exchange = GemmaAIStudio(client=client, sleep=slept.append, max_attempts=3).generate(
        "prompt",
        request_id="r4",
    )
    assert exchange.status == "error"
    assert exchange.attempt_count == 3
    assert len(models.calls) == 3
    assert slept == [0.5, 1.0]


def test_transient_error_then_success() -> None:
    slept: list[float] = []
    state = {"n": 0}

    def behavior(_kwargs):
        state["n"] += 1
        if state["n"] == 1:
            raise TimeoutError("timeout")
        return SimpleNamespace(text="{}", model_version=MODEL_ID, response_id="ok")

    client, _models = _client(behavior)
    exchange = GemmaAIStudio(client=client, sleep=slept.append).generate("prompt", request_id="r5")
    assert exchange.status == "ok"
    assert exchange.raw_response == "{}"
    assert exchange.attempt_count == 2
    assert slept == [0.5]


def test_sdk_missing_does_not_switch_provider(monkeypatch) -> None:
    import builtins

    monkeypatch.setenv("GEMINI_API_KEY", "unique-test-key-value")
    monkeypatch.setenv("GOOGLE_CLOUD_PROJECT", "paid-project")
    for name in [key for key in list(__import__("sys").modules) if key == "google" or key.startswith("google.")]:
        monkeypatch.delitem(__import__("sys").modules, name, raising=False)
    real_import = builtins.__import__

    def blocked(name, *args, **kwargs):
        if name == "google" or name.startswith("google."):
            raise ImportError("blocked")
        return real_import(name, *args, **kwargs)

    monkeypatch.setattr(builtins, "__import__", blocked)
    with pytest.raises(ProviderSetupError, match="google-genai") as caught:
        GemmaAIStudio().generate("prompt", request_id="r6")
    assert "unique-test-key-value" not in str(caught.value)
    assert "paid-project" not in str(caught.value)


def test_client_is_constructed_for_the_gemini_api(monkeypatch) -> None:
    import sys
    from types import ModuleType, SimpleNamespace

    monkeypatch.setenv("GEMINI_API_KEY", "gemini-test-key")
    monkeypatch.setenv("GOOGLE_GENAI_USE_VERTEXAI", "false")
    monkeypatch.setenv("GOOGLE_CLOUD_PROJECT", "paid-project")
    captured: list[dict] = []

    class _Client:
        def __init__(self, **kwargs):
            captured.append(kwargs)
            self.models = SimpleNamespace(
                generate_content=lambda **_kwargs: SimpleNamespace(text="{}", response_id="resp-api")
            )

    google = ModuleType("google")
    genai = ModuleType("google.genai")
    genai.Client = _Client
    google.genai = genai
    monkeypatch.setitem(sys.modules, "google", google)
    monkeypatch.setitem(sys.modules, "google.genai", genai)
    exchange = GemmaAIStudio().generate("prompt", request_id="vertex-off")
    assert captured == [{"vertexai": False, "api_key": "gemini-test-key"}]
    assert "project" not in captured[0]
    assert "location" not in captured[0]
    assert exchange.status == "ok"
    assert exchange.provider_response_id == "resp-api"


def test_vertex_env_is_rejected(monkeypatch) -> None:
    monkeypatch.setenv("GEMINI_API_KEY", "gemini-test-key")
    monkeypatch.setenv("GOOGLE_GENAI_USE_VERTEXAI", "true")
    with pytest.raises(ProviderSetupError, match="Vertex"):
        GemmaAIStudio().generate("prompt", request_id="vertex-on")

