\"\"\"Test-process guard: permit existing loopback fixtures, reject external I/O.\"\"\"
import ipaddress
import socket


def _loopback(address):
    if not isinstance(address, tuple):
        return True  # Unix-domain IPC is local.
    host = address[0]
    if host == 'localhost':
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


_connect = socket.socket.connect
_connect_ex = socket.socket.connect_ex
_bind = socket.socket.bind
_getaddrinfo = socket.getaddrinfo


def connect(self, address):
    if not _loopback(address):
        raise RuntimeError('External network is disabled for the PR10 test run')
    return _connect(self, address)


def connect_ex(self, address):
    if not _loopback(address):
        raise RuntimeError('External network is disabled for the PR10 test run')
    return _connect_ex(self, address)


def bind(self, address):
    if not _loopback(address):
        raise RuntimeError('Non-loopback binding is disabled for the PR10 test run')
    return _bind(self, address)


def getaddrinfo(host, port, *args, **kwargs):
    if host is not None and not _loopback((host, port)):
        raise RuntimeError('External DNS is disabled for the PR10 test run')
    return _getaddrinfo(host, port, *args, **kwargs)


socket.socket.connect = connect
socket.socket.connect_ex = connect_ex
socket.socket.bind = bind
socket.getaddrinfo = getaddrinfo
