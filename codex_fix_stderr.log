"""Load a rubric. Point values here are the allocation, not a teacher score."""

from __future__ import annotations

import json
from pathlib import Path

from harness_v2.core.contracts import RubricItem


def rubric_from_data(items: list[dict]) -> list[RubricItem]:
    rubric: list[RubricItem] = []
    for item in items:
        rubric.append(
            RubricItem(
                item_id=str(item["item_id"]),
                max_points=float(item["max_points"]),
                description=str(item.get("description") or ""),
                acceptable_expression=str(item.get("acceptable_expression") or ""),
            )
        )
    return rubric


def load_rubric(path: Path) -> tuple[str, list[RubricItem]]:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
    version = str(payload.get("version") or "unversioned")
    return version, rubric_from_data(payload["items"])
"""Map a model completion onto ItemResult rows.

A missing score stays None. This module does not copy a 0 or a max into it.
"""

from __future__ import annotations

import json
import math
import re
from typing import Any

from harness_v2.core.contracts import EvidenceSpan, ItemResult, RubricItem

_OPENER = re.compile(r"```(?:json)?[ \t]*\r?\n")


class ScoringParseError(ValueError):
    def __init__(self, message: str, *, raw: str, fence_stripped: bool = False) -> None:
        super().__init__(message)
        self.raw = raw
        self.fence_stripped = fence_stripped


def strip_one_outer_fence(text: str) -> str | None:
    """Same one-fence rule as the existing grader. The body is not rewritten."""
    if "```" not in text:
        return None
    lead = len(text) - len(text.lstrip(" \t\r\n"))
    trail_body = text[lead:]
    trail = len(trail_body) - len(trail_body.rstrip(" \t\r\n"))
    core = text[lead : len(text) - trail] if trail else text[lead:]
    opener = _OPENER.match(core)
    if opener is None or opener.start() != 0 or not core.endswith("```"):
        return None
    body = core[opener.end() : len(core) - 3]
    if body.endswith("\r\n"):
        return body[:-2]
    if body.endswith("\n") or body.endswith("\r"):
        return body[:-1]
    return None


def parse_completion(raw: str) -> tuple[dict[str, Any], bool]:
    try:
        loaded = json.loads(raw)
        fence = False
    except json.JSONDecodeError as first_error:
        body = strip_one_outer_fence(raw)
        if body is None:
            raise ScoringParseError(f"json_parse_failed: {first_error}", raw=raw) from first_error
        try:
            loaded = json.loads(body)
        except json.JSONDecodeError as second_error:
            raise ScoringParseError(
                f"json_parse_failed_after_fence: {second_error}",
                raw=raw,
                fence_stripped=True,
            ) from second_error
        fence = True
    if not isinstance(loaded, dict):
        raise ScoringParseError("json object expected", raw=raw, fence_stripped=fence)
    return loaded, fence


def _number(value: Any) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    if not math.isfinite(number):
        return None
    return number


def _spans(value: Any) -> list[EvidenceSpan]:
    if isinstance(value, str):
        return [EvidenceSpan(text=value)]
    if not isinstance(value, list):
        return []
    spans: list[EvidenceSpan] = []
    for item in value:
        if isinstance(item, str):
            spans.append(EvidenceSpan(text=item))
        elif isinstance(item, dict) and isinstance(item.get("text"), str):
            start = item.get("start")
            end = item.get("end")
            spans.append(
                EvidenceSpan(
                    text=item["text"],
                    start=start if isinstance(start, int) else None,
                    end=end if isinstance(end, int) else None,
                    source=str(item.get("source") or "answer"),
                )
            )
    return spans


def items_from_completion(raw: str, rubric: list[RubricItem]) -> tuple[list[ItemResult], float | None, bool]:
    payload, fence = parse_completion(raw)
    maxima = {item.item_id: item.max_points for item in rubric}
    rows = payload.get("items")
    if rows is None:
        rows = payload.get("rubric_scores")
    if not isinstance(rows, list):
        raise ScoringParseError("items array missing", raw=raw, fence_stripped=fence)
    items: list[ItemResult] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        item_id = str(row.get("item_id") or "")
        if not item_id:
            continue
        claimed = _number(row.get("max_points", row.get("max_score")))
        rubric_max = maxima.get(item_id)
        max_points = float(rubric_max if rubric_max is not None else (claimed if claimed is not None else 0))
        reasons: list[str] = []
        supplied_reason = str(row.get("review_reason") or "")
        if supplied_reason:
            reasons.append(supplied_reason)
        if claimed is not None and rubric_max is not None and abs(claimed - float(rubric_max)) > 1e-6:
            reasons.append("item_max_mismatch")
        if "score" in row and row["score"] is not None and _number(row["score"]) is None:
            reasons.append("score_not_number")
            score = None
        else:
            raw_score = row["score"] if "score" in row else None
            score = _number(raw_score) if raw_score is not None else None
        uncertainty = row.get("uncertainty")
        items.append(
            ItemResult(
                item_id=item_id,
                max_points=max_points,
                score=score,
                evidence_spans=_spans(row.get("evidence_spans", row.get("evidence"))),
                math_reason=str(row.get("math_reason") or row.get("reason") or ""),
                uncertainty=_number(uncertainty) if uncertainty is not None else None,
                review_reason="; ".join(reasons),
            )
        )
    total = payload.get("total_score", payload.get("score"))
    return items, _number(total) if total is not None else None, fence


def build_prompt(problem_text: str, answer_text: str, rubric: list[RubricItem]) -> str:
    """Prompt body. Reference scores are not a field on this object."""
    return json.dumps(
        {
            "problem_text": problem_text,
            "answer_text": answer_text,
            "rubric": [
                {
                    "item_id": item.item_id,
                    "max_points": item.max_points,
                    "description": item.description,
                }
                for item in rubric
            ],
            "instructions": (
                "Return one JSON object and no other text. "
                "The object has items and total_score. "
                "items is an array of objects with item_id, score, evidence_spans, "
                "math_reason, uncertainty, and review_reason. "
                "score is a finite number, or null when the item cannot be graded. Do not invent a score. "
                "evidence_spans is an array of objects with text and optional start, end, and source. "
                "math_reason is a string. "
                "uncertainty is a number from 0 to 1, or null. "
                "review_reason is a string and is empty when the item is clear. "
                "total_score is the sum of the item scores, or null if any score is null. "
                "Rubric max_points is the point allocation. Do not return a different maximum."
            ),
        },
        ensure_ascii=False,
    )
"""Check a grading result. A failed check never fills in a missing score."""

from __future__ import annotations

import math
import re

from harness_v2.core.contracts import Check, GradingResult, ItemResult, RubricItem
from harness_v2.grading.sympy_equiv import mechanical_equivalent

_SPACE = re.compile(r"\s+")
UNCERTAINTY_REVIEW_AT = 0.5


def _collapse(text: str) -> str:
    return _SPACE.sub("", text)


def _finite(value: float | None) -> bool:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    return math.isfinite(float(value))


def _failed(
    rubric: list[RubricItem],
    items: list[ItemResult],
    total_score: float | None,
    reason: str,
    checks: list[Check],
    **meta: str,
) -> GradingResult:
    return GradingResult(
        status="failed",
        items=items,
        total_score=total_score,
        max_points=sum(item.max_points for item in rubric) if rubric else None,
        failure_reason=reason,
        checks=checks,
        request_id=meta.get("request_id", ""),
        provider=meta.get("provider", ""),
        model_id=meta.get("model_id", ""),
        raw_response=meta.get("raw_response", ""),
    )


def validate(
    rubric: list[RubricItem],
    items: list[ItemResult],
    total_score: float | None,
    answer_text: str,
    *,
    request_id: str = "",
    provider: str = "",
    model_id: str = "",
    raw_response: str = "",
) -> GradingResult:
    meta = {
        "request_id": request_id,
        "provider": provider,
        "model_id": model_id,
        "raw_response": raw_response,
    }
    if not rubric:
        return _failed(
            rubric,
            [],
            total_score,
            "empty_rubric",
            [Check("rubric_nonempty", False, "empty_rubric")],
            **meta,
        )
    seen: dict[str, int] = {}
    for item in items:
        seen[item.item_id] = seen.get(item.item_id, 0) + 1
    duplicates = sorted(item_id for item_id, count in seen.items() if count > 1)
    if duplicates:
        return _failed(
            rubric,
            items,
            total_score,
            "duplicate_item_ids:" + ",".join(duplicates),
            [Check("unique_item_ids", False, ",".join(duplicates))],
            **meta,
        )
    by_id = {item.item_id: item for item in items}
    ordered: list[ItemResult] = []
    checks: list[Check] = [Check("rubric_nonempty", True, ""), Check("unique_item_ids", True, "")]
    missing: list[str] = []
    for rubric_item in rubric:
        found = by_id.get(rubric_item.item_id)
        if found is None:
            missing.append(rubric_item.item_id)
            ordered.append(
                ItemResult(
                    item_id=rubric_item.item_id,
                    max_points=rubric_item.max_points,
                    score=None,
                    review_reason="missing_from_model",
                )
            )
            continue
        ordered.append(found)
    extra = sorted(set(by_id) - {item.item_id for item in rubric})
    checks.append(Check("items_present", not missing, ",".join(missing)))
    checks.append(Check("no_extra_items", not extra, ",".join(extra)))

    range_bad: list[str] = []
    reason_bad: list[str] = []
    evidence_bad: list[str] = []
    math_bad: list[str] = []
    review_bad: list[str] = []
    non_numeric: list[str] = []
    max_mismatch: list[str] = []
    score_missing = list(missing)
    haystack = _collapse(answer_text)
    rubric_by_id = {item.item_id: item for item in rubric}
    for item in ordered:
        rubric_item = rubric_by_id.get(item.item_id)
        maximum = rubric_item.max_points if rubric_item is not None else item.max_points
        if "item_max_mismatch" in item.review_reason:
            max_mismatch.append(item.item_id)
        if item.score is not None and not _finite(item.score):
            non_numeric.append(item.item_id)
            if item.item_id not in score_missing:
                score_missing.append(item.item_id)
            continue
        if item.score is None:
            if item.item_id not in score_missing:
                score_missing.append(item.item_id)
            continue
        if item.score < 0 or item.score > maximum:
            range_bad.append(f"{item.item_id}:{item.score}/{maximum}")
        if not item.math_reason.strip():
            reason_bad.append(item.item_id)
        if not item.evidence_spans or any(not span.text.strip() for span in item.evidence_spans):
            evidence_bad.append(item.item_id)
        else:
            for span in item.evidence_spans:
                if _collapse(span.text) not in haystack:
                    evidence_bad.append(item.item_id)
                    break
        expression = rubric_item.acceptable_expression if rubric_item else ""
        if expression and item.evidence_spans:
            verdict = mechanical_equivalent(item.evidence_spans[0].text, expression)
            if verdict is False:
                math_bad.append(item.item_id)
        reason = item.review_reason.strip()
        if reason and reason != "missing_from_model":
            review_bad.append(f"{item.item_id}:{reason}")
        if _finite(item.uncertainty) and float(item.uncertainty or 0) >= UNCERTAINTY_REVIEW_AT:
            review_bad.append(f"{item.item_id}:uncertainty")
    checks.append(Check("scores_present", not score_missing, ",".join(score_missing)))
    checks.append(Check("score_numeric", not non_numeric, ",".join(non_numeric)))
    checks.append(Check("score_range", not range_bad, ",".join(range_bad)))
    checks.append(Check("item_max_matches_rubric", not max_mismatch, ",".join(max_mismatch)))
    checks.append(Check("reason_present", not reason_bad, ",".join(reason_bad)))
    checks.append(Check("evidence_traceable", not evidence_bad, ",".join(evidence_bad)))
    checks.append(Check("sympy_equivalence", not math_bad, ",".join(math_bad)))
    checks.append(Check("review_flags", not review_bad, ",".join(review_bad)))

    numeric = [item.score for item in ordered if _finite(item.score)]
    all_numeric = len(numeric) == len(rubric) and not score_missing
    if total_score is None or not _finite(total_score):
        checks.append(Check("total_matches", False, "total_missing"))
    elif not all_numeric:
        checks.append(Check("total_matches", False, "scores_incomplete"))
    else:
        summed = float(sum(numeric))
        matches = abs(summed - float(total_score)) <= 1e-6
        checks.append(
            Check("total_matches", matches, "" if matches else f"{summed}!={total_score}")
        )

    hard_fail = bool(missing or score_missing or non_numeric)
    review_names = [
        check.name
        for check in checks
        if not check.ok and check.name not in {"items_present", "scores_present", "score_numeric", "rubric_nonempty"}
    ]
    if hard_fail:
        status = "failed"
        reason = "missing_score:" + ",".join(score_missing)
    elif review_names:
        status = "review_required"
        reason = ",".join(review_names)
    else:
        status = "validated"
        reason = ""
    return GradingResult(
        status=status,  # type: ignore[arg-type]
        items=ordered,
        total_score=total_score,
        max_points=sum(item.max_points for item in rubric),
        failure_reason=reason,
        request_id=request_id,
        provider=provider,
        model_id=model_id,
        raw_response=raw_response,
        checks=checks,
    )

