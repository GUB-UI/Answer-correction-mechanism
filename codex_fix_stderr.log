"""Xiaomi-OCR-0 as its own step.

Imported text and CPU output are stored twice: an exclusive exact copy under
``ocr_private/``, and a redacted sibling under ``ocr/`` for anything that
can be committed. The grading input is the exact copy and its sha256.

CPU inference runs ``harness_v2.recognition.run_ocr_cpu`` in a subprocess.
bfloat16 is refused. The model is not downloaded by unit tests.
"""

from __future__ import annotations

import json
import subprocess
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable

from harness_v2.recognition.run_ocr_cpu import (
    MODEL_ID,
    REVISION,
    CPUOCRRefused,
    assert_runnable,
    available_bytes,
    cpu_command,
)
from harness_v2.storage.artifacts import ArtifactStore

_IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tif", ".tiff"}


@dataclass(frozen=True)
class CPURequirement:
    reasonable: bool
    model_id: str
    message: str


@dataclass(frozen=True)
class OCRArtifact:
    ocr_id: str
    source_name: str
    engine: str
    raw_text: str
    artifact_name: str
    sha256: str
    redacted_name: str
    revision: str = ""
    dtype: str = ""
    elapsed_s: float | None = None


class OCRNotRunnable(RuntimeError):
    def __init__(self, requirement: CPURequirement) -> None:
        super().__init__(requirement.message)
        self.requirement = requirement


class OCRImportError(ValueError):
    pass


def assess_cpu_xiaomi(*, dtype: str = "float32", free_bytes: int | None = None) -> CPURequirement:
    free = available_bytes() if free_bytes is None else free_bytes
    try:
        assert_runnable(dtype, free)
    except CPUOCRRefused as exc:
        return CPURequirement(False, MODEL_ID, str(exc))
    return CPURequirement(
        True,
        MODEL_ID,
        f"{MODEL_ID} can be attempted on CPU in float32 at revision {REVISION}.",
    )


class XiaomiOCR:
    def __init__(
        self,
        artifacts: ArtifactStore,
        *,
        runner: Callable[[Path], tuple[str, dict[str, Any]]] | None = None,
        free_bytes: Callable[[], int] | None = None,
        dtype: str = "float32",
    ) -> None:
        self.artifacts = artifacts
        self._runner = runner
        self._free_bytes = free_bytes or available_bytes
        self.dtype = dtype

    def import_file(self, path: Path, *, ocr_id: str) -> OCRArtifact:
        source = Path(path)
        if source.suffix.lower() in _IMAGE_SUFFIXES:
            raise OCRImportError("import OCR text, not a student image")
        if not source.is_file():
            raise OCRImportError(f"OCR text file not found: {source}")
        raw = source.read_text(encoding="utf-8")
        return self._store(ocr_id, source.name, raw)

    def store_text(self, raw: str, *, ocr_id: str, source_name: str) -> OCRArtifact:
        return self._store(ocr_id, source_name, raw)

    def run_cpu(self, image_path: Path, *, ocr_id: str) -> OCRArtifact:
        requirement = assess_cpu_xiaomi(dtype=self.dtype, free_bytes=self._free_bytes())
        if not requirement.reasonable:
            raise OCRNotRunnable(requirement)
        if self._runner is not None:
            text, meta = self._runner(Path(image_path))
        else:
            text, meta = _subprocess_ocr(Path(image_path), dtype=self.dtype)
        return self._store(
            ocr_id,
            Path(image_path).name,
            text,
            revision=str(meta.get("revision") or REVISION),
            dtype=str(meta.get("dtype") or "float32"),
            elapsed_s=_optional_float(meta.get("wall_s", meta.get("elapsed_s"))),
        )

    def _store(
        self,
        ocr_id: str,
        source_name: str,
        raw: str,
        *,
        revision: str = "",
        dtype: str = "",
        elapsed_s: float | None = None,
    ) -> OCRArtifact:
        private_name = f"ocr_private/{ocr_id}.txt"
        public_name = f"ocr/{ocr_id}.txt"
        _path, digest = self.artifacts.write_private_text(private_name, raw)
        self.artifacts.write_text(public_name, raw)
        return OCRArtifact(
            ocr_id=ocr_id,
            source_name=source_name,
            engine=MODEL_ID,
            raw_text=raw,
            artifact_name=private_name,
            sha256=digest,
            redacted_name=public_name,
            revision=revision,
            dtype=dtype,
            elapsed_s=elapsed_s,
        )


def _optional_float(value: Any) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def _subprocess_ocr(image_path: Path, *, dtype: str) -> tuple[str, dict[str, Any]]:
    with tempfile.TemporaryDirectory(prefix="xiaomi-ocr-") as directory:
        out_dir = Path(directory)
        command = cpu_command(image_path, out_dir, dtype=dtype)
        completed = subprocess.run(command, check=False, capture_output=True, text=True)
        if completed.returncode != 0:
            raise OCRNotRunnable(
                CPURequirement(
                    False,
                    MODEL_ID,
                    completed.stderr.strip() or f"CPU OCR exited {completed.returncode}",
                )
            )
        text_path = out_dir / f"{image_path.stem}.md"
        stats_path = out_dir / "stats.jsonl"
        if not text_path.is_file():
            raise OCRNotRunnable(CPURequirement(False, MODEL_ID, "CPU OCR wrote no transcript"))
        meta: dict[str, Any] = {"revision": REVISION, "dtype": dtype}
        if stats_path.is_file():
            line = stats_path.read_text(encoding="utf-8").strip().splitlines()[-1]
            loaded = json.loads(line)
            if isinstance(loaded, dict):
                meta.update(loaded)
        return text_path.read_text(encoding="utf-8"), meta
"""File and GitHub handoff for Grokbot. No HTTP model API.

A request and its result share `request_id`. GitHub delivery writes the
issue, branch, and pull-request text as files. Opening them is a separate
step and is not done here.
"""

from __future__ import annotations

import json
import re
from pathlib import Path
from typing import Any

from harness_v2.storage.secrets import redact

_REQUEST_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
_DATA_URI = re.compile(r"data:image/[a-zA-Z0-9.+-]+;base64,[A-Za-z0-9+/=\s]+", re.IGNORECASE)

_SCHEMAS = Path(__file__).resolve().parent / "schemas"


class SchemaError(ValueError):
    pass


def _load_schema(name: str) -> dict[str, Any]:
    return json.loads((_SCHEMAS / name).read_text(encoding="utf-8"))


def _check(value: Any, schema: dict[str, Any], path: str) -> list[str]:
    errors: list[str] = []
    expected = schema.get("type")
    if expected == "object":
        if not isinstance(value, dict):
            return [f"{path or 'object'} must be an object"]
        required = schema.get("required") or []
        for key in required:
            if key not in value:
                errors.append(f"{path + '.' if path else ''}{key} is required")
        if schema.get("additionalProperties") is False:
            allowed = set((schema.get("properties") or {}).keys())
            for key in value:
                if key not in allowed:
                    errors.append(f"{path + '.' if path else ''}{key} is not allowed")
        for key, sub in (schema.get("properties") or {}).items():
            if key in value:
                child = f"{path}.{key}" if path else key
                errors.extend(_check(value[key], sub, child))
        return errors
    if expected == "array":
        if not isinstance(value, list):
            return [f"{path} must be an array"]
        item_schema = schema.get("items") or {}
        for index, item in enumerate(value):
            errors.extend(_check(item, item_schema, f"{path}[{index}]"))
        return errors
    if expected == "string":
        if not isinstance(value, str):
            return [f"{path} must be a string"]
        if schema.get("minLength") and len(value) < schema["minLength"]:
            return [f"{path} is empty"]
        return errors
    if "enum" in schema:
        if value not in schema["enum"]:
            return [f"{path} must be one of {schema['enum']}"]
        return errors
    if expected == "boolean" and not isinstance(value, bool):
        return [f"{path} must be a boolean"]
    return errors


def safe_request_id(request_id: str) -> str:
    if not isinstance(request_id, str) or _REQUEST_ID.fullmatch(request_id) is None:
        raise SchemaError(f"request_id is not a safe token: {request_id!r}")
    return request_id


def strip_image_data(value: Any) -> Any:
    if isinstance(value, str):
        return _DATA_URI.sub("[stripped-image]", value)
    if isinstance(value, dict):
        return {str(key): strip_image_data(item) for key, item in value.items()}
    if isinstance(value, list):
        return [strip_image_data(item) for item in value]
    return value


def _inside(root: Path, path: Path) -> Path:
    resolved_root = root.resolve()
    resolved = path.resolve()
    if resolved != resolved_root and resolved_root not in resolved.parents:
        raise SchemaError(f"path escapes the exchange directory: {path}")
    return resolved


def validate_request(payload: dict[str, Any]) -> None:
    errors = _check(payload, _load_schema("grokbot_request.schema.json"), "")
    if errors:
        raise SchemaError("; ".join(errors))


def validate_result(payload: dict[str, Any]) -> None:
    errors = _check(payload, _load_schema("grokbot_result.schema.json"), "")
    if errors:
        raise SchemaError("; ".join(errors))


class FileExchange:
    def __init__(self, root: Path) -> None:
        self.root = Path(root)
        (self.root / "requests").mkdir(parents=True, exist_ok=True)
        (self.root / "results").mkdir(parents=True, exist_ok=True)

    def _path(self, folder: str, request_id: str) -> Path:
        token = safe_request_id(request_id)
        return _inside(self.root / folder, self.root / folder / f"{token}.json")

    def publish_request(self, payload: dict[str, Any]) -> Path:
        cleaned = redact(strip_image_data(payload))
        validate_request(cleaned)
        path = self._path("requests", cleaned["request_id"])
        path.write_text(json.dumps(cleaned, ensure_ascii=False, indent=2), encoding="utf-8")
        return path

    def write_result(self, payload: dict[str, Any]) -> Path:
        cleaned = redact(strip_image_data(payload))
        validate_result(cleaned)
        request_path = self._path("requests", cleaned["request_id"])
        if not request_path.exists():
            raise SchemaError(f"no request with request_id {cleaned['request_id']}")
        path = self._path("results", cleaned["request_id"])
        path.write_text(json.dumps(cleaned, ensure_ascii=False, indent=2), encoding="utf-8")
        return path

    def read_result(self, request_id: str) -> dict[str, Any]:
        path = self._path("results", request_id)
        payload = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(payload, dict):
            raise SchemaError("result is not an object")
        validate_result(payload)
        if payload.get("request_id") != request_id:
            raise SchemaError("result request_id does not match the file")
        return payload


class GitHubHandoff:
    """Write the Issue, branch name, and PR body. Do not call GitHub."""

    def __init__(self, root: Path) -> None:
        self.root = Path(root)

    def write(self, payload: dict[str, Any]) -> Path:
        cleaned = redact(strip_image_data(payload))
        validate_request(cleaned)
        request_id = safe_request_id(cleaned["request_id"])
        folder = _inside(self.root, self.root / "handoff" / request_id)
        folder.mkdir(parents=True, exist_ok=True)
        branch = f"harness/{request_id}"
        (folder / "request.json").write_text(
            json.dumps(cleaned, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        (folder / "branch.txt").write_text(branch + "\n", encoding="utf-8")
        (folder / "issue.md").write_text(
            f"# Grokbot {cleaned['kind']} {request_id}\n\n"
            f"experiment: {cleaned['experiment_id']}\n\n"
            f"commit: {cleaned['commit']}\n\n"
            "Open this file as a GitHub issue. The harness does not post it.\n",
            encoding="utf-8",
        )
        (folder / "pr.md").write_text(
            f"# PR for {request_id}\n\n"
            f"Branch `{branch}` holds the handoff files for this request_id.\n"
            "Open the pull request separately. This file is the body.\n",
            encoding="utf-8",
        )
        return folder
