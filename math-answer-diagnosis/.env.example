OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=omlx
OCR_PROVIDER=glmocr_sdk
OCR_MODEL_NAME=mlx-community/GLM-OCR-bf16
UNIMERNET_ENABLED=true
UNIMERNET_MODEL_NAME=wanderkid/unimernet_small
UNIMERNET_BASE_URL=http://127.0.0.1:8091
DIAGNOSIS_PROVIDER=omlx
DIAGNOSIS_MODEL_NAME=Qwen3.8-27B-oQ4e-mtp
# 任意: 未指定なら診断モデルを自動タグ付けにも使用
# TAGGING_MODEL_NAME=Qwen3.8-27B-oQ4e-mtp

# --- Colab で使うとき（Mac では空のままでよい）---
# セットアップが次を .env に書く。手書きの主 OCR は Xiaomi-OCR-0。GLM は代替。
# OCR_PROVIDER=xiaomi_ocr
# OCR_MODEL_NAME=SeerRay-Lab/Xiaomi-OCR-0
# XIAOMI_OCR_MODEL_ID=SeerRay-Lab/Xiaomi-OCR-0
# UNIMERNET_ENABLED=false
# DIAGNOSIS_PROVIDER=colab_cuda
# OCR_API_PORT=8081
# APP_CONFIG_FILE=config.colab.yaml
# APP_DATA_DIR=/content/drive/MyDrive/answer-correction
# HF_HOME=/content/drive/MyDrive/answer-correction/hf-cache
# SERVICE_MODE=managed
# LLM_MODEL_ID は `python -m src gpu-profile --write-env .env` が GPU に合わせて書く
# APP_PASSWORD=change-me
# COMPARE_RATIO_THRESHOLD=0.2
# COMPARE_RECHECK_MODE=blind
# Colab では TAGGING_MODEL_NAME を空のままにする。載せる重みは診断モデルの1つだけ。
